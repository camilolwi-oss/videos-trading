{
  "name": "wyckoff-estructuras",
  "version": "1.0.0",
  "private": true,
  "description": "Indicador Wyckoff (Pine Script v6) probado con PineTS y visualizado con Vela de LuxAlgo",
  "type": "module",
  "scripts": {
    "test": "node test/run-pinets.mjs -v",
    "demo": "vite",
    "build:demo": "vite build --outDir ../dist-demo --emptyOutDir",
    "build:pages": "vite build --outDir ../../../docs --emptyOutDir && touch ../../docs/.nojekyll"
  },
  "dependencies": {
    "@luxalgo/vela": "^0.8.2",
    "@luxalgo/vela-pinets": "^0.2.15",
    "pinets": "^0.11.0"
  },
  "devDependencies": {
    "vite": "^7.0.0"
  }
}
