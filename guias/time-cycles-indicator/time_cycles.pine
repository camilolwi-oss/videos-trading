//@version=6
indicator("Ciclos de Tiempo · Time Cycles", shorttitle = "Time Cycles", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500, max_polylines_count = 100)

// ════════════════════════════════════════════════════════════════════════════
//  Ciclos de Tiempo · Time Cycles  (Hurst + simetría)
//  Basado en "Beginner's Guide to Time Cycles" (Mr. Abundance).
//  Documentación completa: guias/time-cycles-indicator/README.md
//
//  Flujo del motor (todo se calcula en la última barra):
//   1. Guarda la historia reciente en arrays y arma tablas de rango (RMQ).
//   2. Detecta mínimos mayores por prominencia (anclas automáticas).
//   3. Prueba cada par de anclas con subdivisión 2/3/5 → 2/3 y se queda con
//      la combinación con mejor tasa de acierto (ritmo dominante).
//   4. Valida cada pivote proyectado con ventana ±% (5/10/15 %).
//   5. VTL, estadística de pivotes, momentum, ratio, sincronía y alertas.
// ════════════════════════════════════════════════════════════════════════════

// ───────────────────────────── 1 · General ─────────────────────────────
G1 = "1 · General"
iLang    = input.string("Español", "Idioma / Language", options = ["Español", "English"], group = G1)
iMaxBars = input.int(5000, "Barras analizadas / Bars analyzed", minval = 150, maxval = 20000, step = 250, group = G1, tooltip = "ES: cuántas barras recientes usa el motor. Más barras = más historia, más cálculo.\nEN: how many recent bars the engine uses. More bars = more history, more computation.")
iBase    = input.string("Auto", "Base de tiempo / Time base", options = ["Auto", "Calendario / Calendar", "Barras / Bars"], group = G1, tooltip = "ES: Calendario mide los ciclos en días reales (tabla de Hurst). Barras cuenta velas (útil en intradía de acciones/FX con sesiones). Auto = barras en intradía no cripto, calendario en el resto.\nEN: Calendar measures cycles in real days (Hurst table). Bars counts candles (useful for intraday stocks/FX with sessions). Auto = bars on non-crypto intraday, calendar otherwise.")
iSrc     = input.string("Mecha / Wick", "Mínimos y máximos / Lows & highs", options = ["Mecha / Wick", "Cierre / Close", "HLC3"], group = G1, tooltip = "ES: la guía sugiere leer el flujo (modo línea/HLC) para ignorar mechas atípicas.\nEN: the guide suggests reading flow (line/HLC mode) to ignore outlier wicks.")
iLog     = input.bool(true, "Escala logarítmica / Log scale", group = G1, tooltip = "ES: usar igual que la escala del gráfico. Afecta arcos, VTL y objetivos.\nEN: match your chart scale. Affects arcs, VTL and targets.")
iFit     = input.bool(true, "Ajustar al rango visible / Fit to visible range", group = G1, tooltip = "ES: arcos y marcas se dibujan en el rango visible (recalcula al desplazar el gráfico).\nEN: arcs and marks are drawn in the visible range (recalculates when scrolling).")
iProj    = input.float(1.0, "Proyección (ciclos madre) / Projection (master cycles)", minval = 0.25, maxval = 3.0, step = 0.25, group = G1)

// ───────────────────────────── 2 · Anclas ─────────────────────────────
G2 = "2 · Anclas / Anchors"
iAnchor  = input.string("Auto", "Modo de anclas / Anchor mode", options = ["Auto", "Manual"], group = G2, tooltip = "ES: Auto detecta los mínimos mayores por prominencia y elige el par + subdivisión con mejor tasa de acierto. Manual usa las dos fechas de abajo.\nEN: Auto detects major lows by prominence and picks the pair + subdivision with the best hit rate. Manual uses the two dates below.")
iT1      = input.time(timestamp("15 Dec 2018 00:00 +0000"), "Ancla manual 1 / Manual anchor 1", group = G2)
iT2      = input.time(timestamp("21 Nov 2022 00:00 +0000"), "Ancla manual 2 / Manual anchor 2", group = G2)
iPivStr  = input.int(0, "Fuerza de pivote (0 = auto) / Pivot strength (0 = auto)", minval = 0, maxval = 500, group = G2, tooltip = "ES: barras a cada lado para considerar un mínimo. 0 = automático según la historia.\nEN: bars on each side to qualify a low. 0 = automatic from history length.")
iCand    = input.int(8, "Mínimos candidatos / Candidate lows", minval = 3, maxval = 12, group = G2)
iMerge   = input.bool(true, "Fusionar mínimos dobles (punto medio) / Merge double bottoms (midpoint)", group = G2)
iMergeT  = input.float(2.0, "Tolerancia mínimo doble % / Double-bottom tolerance %", minval = 0.2, maxval = 10.0, step = 0.1, group = G2)
iMinMast = input.float(8.0, "Ciclo madre mínimo (% historia) / Min master cycle (% history)", minval = 2.0, maxval = 60.0, step = 1.0, group = G2)

// ───────────────────────────── 3 · Subdivisión ─────────────────────────────
G3 = "3 · Subdivisión / Subdivision"
iR1      = input.string("Auto", "Madre → N1 / Master → L1", options = ["Auto", "2", "3", "5"], group = G3)
iR2      = input.string("Auto", "N1 → N2 / L1 → L2", options = ["Auto", "2", "3"], group = G3)
iR3      = input.string("Auto", "N2 → N3 / L2 → L3", options = ["Auto", "2", "3"], group = G3)
iMinBars = input.int(4, "Longitud mínima de ciclo (barras) / Min cycle length (bars)", minval = 3, maxval = 200, group = G3)
iShow0   = input.bool(true, "Madre / Master", inline = "lv", group = G3)
iShow1   = input.bool(true, "N1 / L1", inline = "lv", group = G3)
iShow2   = input.bool(true, "N2 / L2", inline = "lv", group = G3)
iShow3   = input.bool(true, "N3 / L3", inline = "lv", group = G3)

// ───────────────────────────── 4 · Ventanas ─────────────────────────────
G4 = "4 · Ventanas / Windows"
iWin     = input.float(10.0, "Ventana válida ±% / Valid window ±%", minval = 3.0, maxval = 15.0, step = 0.5, group = G4, tooltip = "ES: la guía recomienda ±10 % (5 % = zona ideal, 15 % = límite).\nEN: the guide recommends ±10 % (5 % = ideal zone, 15 % = limit).")
iBull    = input.bool(true, "Diana 5/10/15 % en el próximo pivote / Bullseye on next pivot", group = G4)
iHurst   = input.bool(true, "Ciclos Hurst tras mínimo extremo (≤20W) / Hurst cycles after extreme low (≤20W)", group = G4)
iMoney   = input.bool(true, "Etiquetas entra/sale dinero / Money in/out labels", group = G4)

// ───────────────────────────── 5 · Validación ─────────────────────────────
G5 = "5 · Validación / Validation"
iTarget  = input.float(80.0, "Tasa de acierto objetivo % / Target hit rate %", minval = 50.0, maxval = 100.0, group = G5)
iMarks   = input.string("Nivel de trading / Trading level", "Marcas de acierto / Hit marks", options = ["Nivel de trading / Trading level", "Todos / All", "Ninguno / None"], group = G5)
iGhost   = input.bool(true, "Pivote fantasma tras 2 fallos / Ghost pivot after 2 misses", group = G5)
iShift   = input.bool(true, "Ciclos desplazados (ajuste de fase) / Shifted cycles (phase shift)", group = G5)

// ───────────────────────────── 6 · VTL y señales ─────────────────────────────
G6 = "6 · VTL y señales / VTL & signals"
iTL      = input.string("Dominante / Dominant", "Nivel de trading / Trading level", options = ["Dominante / Dominant", "Madre / Master", "N1 / L1", "N2 / L2", "N3 / L3"], group = G6, tooltip = "ES: nivel usado para VTL, señales, estadística y alertas.\nEN: level used for VTL, signals, statistics and alerts.")
iVtl     = input.bool(true, "Dibujar VTL / Draw VTL", group = G6)
iSigHist = input.bool(true, "Historial de señales / Signal history", group = G6)
iTrade   = input.bool(true, "Niveles de la última señal / Last signal levels", group = G6)

// ───────────────────────────── 7 · Estadística ─────────────────────────────
G7 = "7 · Estadística de pivotes / Pivot statistics"
iStats   = input.bool(true, "Proyectar objetivos estadísticos / Project statistical targets", group = G7)
iStatMin = input.int(3, "Pivotes mínimos para estadística / Min pivots for stats", minval = 2, maxval = 20, group = G7)

// ───────────────────────────── 8 · Momentum ─────────────────────────────
G8 = "8 · Momentum"
iEmaF    = input.int(20, "EMA rápida / Fast EMA", minval = 2, inline = "ema", group = G8)
iEmaS    = input.int(50, "EMA lenta / Slow EMA", minval = 3, inline = "ema", group = G8)
iAtrL    = input.int(14, "ATR", minval = 2, group = G8)
iBaseD   = input.int(90, "Base mínima en días (TF ≥ 1D) / Min base in days (TF ≥ 1D)", minval = 10, group = G8, tooltip = "ES: la guía pide un rango de 3+ meses. En intradía se usa medio ciclo de trading.\nEN: the guide asks for a 3+ month range. Intraday uses half a trading cycle.")
iBaseAtr = input.float(15.0, "Rango máximo de la base (× ATR) / Max base range (× ATR)", minval = 2.0, group = G8)
iMomAl   = input.int(4, "Puntaje para alerta / Score for alert", minval = 1, maxval = 5, group = G8)
iShowEma = input.bool(false, "Mostrar EMAs / Show EMAs", group = G8)

// ───────────────────────────── 9 · Ratio ─────────────────────────────
G9 = "9 · Ratio"
iRMode   = input.string("Desactivado / Off", "Modo / Mode", options = ["Desactivado / Off", "Activo ÷ Símbolo / Asset ÷ Symbol", "Símbolo ÷ Activo / Symbol ÷ Asset", "Fórmula / Formula"], group = G9, tooltip = "ES: ejemplos de la guía: BTC ÷ SP:SPX, TIP ÷ BTC (Símbolo ÷ Activo), ETH ÷ XAGUSD. Fórmula admite expresiones como CRYPTOCAP:USDT.D-CRYPTOCAP:USDC.D.\nEN: guide examples: BTC ÷ SP:SPX, TIP ÷ BTC (Symbol ÷ Asset), ETH ÷ XAGUSD. Formula accepts expressions like CRYPTOCAP:USDT.D-CRYPTOCAP:USDC.D.")
iRSym    = input.symbol("SP:SPX", "Símbolo / Symbol", group = G9)
iRForm   = input.string("CRYPTOCAP:USDT.D-CRYPTOCAP:USDC.D", "Fórmula / Formula", group = G9)

// ───────────────────────────── 10 · Visual ─────────────────────────────
G10 = "10 · Visual"
iArcH    = input.float(22.0, "Altura de arcos % / Arc height %", minval = 5.0, maxval = 60.0, group = G10)
iCol0    = input.color(#B0B0B0, "Madre / Master", inline = "c1", group = G10)
iCol1    = input.color(#E6B422, "N1", inline = "c1", group = G10)
iCol2    = input.color(#B8733A, "N2", inline = "c1", group = G10)
iCol3    = input.color(#8C8C8C, "N3", inline = "c1", group = G10)
iColH    = input.color(#9C6ADE, "Hurst", inline = "c2", group = G10)
iColUp   = input.color(#26A69A, "Largo / Long", inline = "c2", group = G10)
iColDn   = input.color(#EF5350, "Corto / Short", inline = "c2", group = G10)
iTable   = input.bool(true, "Mostrar tabla / Show table", group = G10)
iTblPos  = input.string("Arriba derecha / Top right", "Posición tabla / Table position", options = ["Arriba derecha / Top right", "Abajo derecha / Bottom right", "Arriba izquierda / Top left", "Abajo izquierda / Bottom left"], group = G10)
iTblSize = input.string("Pequeña / Small", "Tamaño tabla / Table size", options = ["Diminuta / Tiny", "Pequeña / Small", "Normal"], group = G10)

// ───────────────────────────── 11 · Alertas ─────────────────────────────
G11 = "11 · Alertas / Alerts"
iAWin    = input.bool(true, "Entrada en ventana / Window entry", group = G11)
iAIdeal  = input.bool(true, "Fecha ideal del pivote / Ideal pivot date", group = G11)
iAInv    = input.bool(true, "Ciclo invalidado / Cycle invalidated", group = G11)
iASig    = input.bool(true, "Señales VTL / VTL signals", group = G11)
iAMom    = input.bool(true, "Momentum en pivote / Momentum at pivot", group = G11)
iASync   = input.bool(true, "Sincronía de ciclos / Cycle synchrony", group = G11)
iATp     = input.bool(true, "Objetivo estadístico / Statistical target", group = G11)
iARatio  = input.bool(true, "Ratio en ventana / Ratio in window", group = G11)

// ════════════════════════════════════════════════════════════════════════════
//  Tipos
// ════════════════════════════════════════════════════════════════════════════
// Fila de una tabla de rango disperso (sparse table) para mínimos/máximos O(1).
type Row
    array<int> v

// Serie de precios analizada (gráfico principal o ratio).
type Ser
    array<int>   t
    array<float> h
    array<float> l
    array<float> c
    array<Row>   mn
    array<Row>   mx
    array<int>   lg
    array<int>   pw
    int          n     = 0
    bool         cal   = true
    float        msBar = 0.0

// Un grado de ciclo (Madre, N1, N2, N3) y su validación.
type Lvl
    int          id
    float        len    = 0.0
    int          ratio  = 1
    bool         on     = false
    int          valid  = 0
    int          tested = 0
    float        score  = 0.0
    int          st1    = -1
    int          st2    = -1
    int          lastTr = -1
    float        lastPx = na
    float        nextPx = na
    bool         active = false
    array<float> px
    array<int>   st
    array<int>   tro

// ════════════════════════════════════════════════════════════════════════════
//  Utilidades
// ════════════════════════════════════════════════════════════════════════════
ES = iLang == "Español"
txt(string es, string en) => ES ? es : en

newSer() => Ser.new(array.new<int>(), array.new<float>(), array.new<float>(), array.new<float>(), array.new<Row>(), array.new<Row>(), array.new<int>(), array.new<int>())

newLvl(int id) => Lvl.new(id, px = array.new<float>(), st = array.new<int>(), tro = array.new<int>())

lvName(int i) => i == 0 ? txt("Madre", "Master") : (ES ? "N" : "L") + str.tostring(i)

fmtT(int t) => str.format_time(t, timeframe.isintraday ? "dd/MM/yy HH:mm" : "dd/MM/yyyy", syminfo.timezone)

fmtDays(float d) => math.abs(d) >= 1.0 ? str.tostring(d, "#.#") + "D" : str.tostring(d * 24.0, "#.#") + "h"

fmtPct(float v) => (v >= 0 ? "+" : "") + str.tostring(v * 100.0, "#.#") + "%"

yToP(float y, bool lg) => lg ? math.exp(y) : y
pToY(float p, bool lg) => lg ? math.log(p) : p

lvlScore(float sc, int te) => te > 0 ? (sc / te) * (te / (te + 3.0)) : 0.0
ratioPen(int r) => r == 2 ? 0.0 : r == 3 ? 0.02 : 0.10

// Opciones de subdivisión (Auto = probar 2, 3 y opcionalmente 5).
optsOf(string sel, bool allow5) =>
    a = array.new<int>()
    if sel == "Auto"
        a.push(2)
        a.push(3)
        if allow5
            a.push(5)
    else
        a.push(int(str.tonumber(sel)))
    a

// Ciclo nominal de Hurst más cercano (±15 %).
hurstName(float days) =>
    names = array.from("5D", "10D", "20D", "40D", "80D", "20W", "9M", "18M", "27M", "54M", "9Y", "18Y")
    vals  = array.from(5.0, 10.0, 20.0, 40.0, 80.0, 140.0, 270.0, 540.0, 822.0, 1095.0, 3285.0, 6570.0)
    string res = "—"
    float bestE = 0.15
    for i = 0 to vals.size() - 1
        e = math.abs(days / vals.get(i) - 1.0)
        if e <= bestE
            bestE := e
            res := "≈" + names.get(i)
    res

// ─── Construcción de la serie: log2, potencias y tablas de rango (RMQ)
buildSer(Ser s, bool cal) =>
    n = s.t.size()
    s.n := n
    s.cal := cal
    s.msBar := n > 1 ? (s.t.get(n - 1) - s.t.get(0)) / (n - 1.0) : timeframe.in_seconds() * 1000.0
    s.lg.clear()
    s.pw.clear()
    s.mn.clear()
    s.mx.clear()
    if n > 0
        s.lg.push(0)
        for i = 1 to n
            s.lg.push(i == 1 ? 0 : s.lg.get(int(i / 2)) + 1)
        r0n = array.new<int>(n, 0)
        r0x = array.new<int>(n, 0)
        for i = 0 to n - 1
            r0n.set(i, i)
            r0x.set(i, i)
        s.mn.push(Row.new(r0n))
        s.mx.push(Row.new(r0x))
        s.pw.push(1)
        int k = 1
        int p = 2
        while p <= n
            pn = s.mn.get(k - 1).v
            pm = s.mx.get(k - 1).v
            half = int(p / 2)
            cnt = n - p + 1
            rn = array.new<int>(cnt, 0)
            rx = array.new<int>(cnt, 0)
            for i = 0 to cnt - 1
                a = pn.get(i)
                b = pn.get(i + half)
                rn.set(i, s.l.get(a) <= s.l.get(b) ? a : b)
                c = pm.get(i)
                d = pm.get(i + half)
                rx.set(i, s.h.get(c) >= s.h.get(d) ? c : d)
            s.mn.push(Row.new(rn))
            s.mx.push(Row.new(rx))
            s.pw.push(p)
            k += 1
            p *= 2
    n

// Índice del mínimo (low) en [l0, r0]. -1 si el rango es vacío.
qMin(Ser s, int l0, int r0) =>
    int l = math.max(l0, 0)
    int r = math.min(r0, s.n - 1)
    int res = -1
    if l <= r
        k = s.lg.get(r - l + 1)
        row = s.mn.get(k).v
        a = row.get(l)
        b = row.get(r - s.pw.get(k) + 1)
        res := s.l.get(a) <= s.l.get(b) ? a : b
    res

// Índice del máximo (high) en [l0, r0]. -1 si el rango es vacío.
qMax(Ser s, int l0, int r0) =>
    int l = math.max(l0, 0)
    int r = math.min(r0, s.n - 1)
    int res = -1
    if l <= r
        k = s.lg.get(r - l + 1)
        row = s.mx.get(k).v
        a = row.get(l)
        b = row.get(r - s.pw.get(k) + 1)
        res := s.h.get(a) >= s.h.get(b) ? a : b
    res

// ─── Eje X del ciclo: tiempo (ms) en modo calendario, índice de barra en modo barras
xOf(Ser s, int i) => s.cal ? float(s.t.get(i)) : float(i)

// Primer índice con tiempo >= t (0..n).
idxCeilT(Ser s, float t) =>
    int lo = 0
    int hi = s.n
    while lo < hi
        mid = int((lo + hi) / 2)
        if s.t.get(mid) < t
            lo := mid + 1
        else
            hi := mid
    lo

// Primera barra con x >= x0 (0..n).
bCeil(Ser s, float x) => s.cal ? idxCeilT(s, x) : math.min(math.max(int(math.ceil(x - 1e-6)), 0), s.n)

// Última barra con x <= x0 (-1..n-1).
bFloor(Ser s, float x) => s.cal ? idxCeilT(s, math.floor(x) + 1.0) - 1 : math.max(math.min(int(math.floor(x + 1e-6)), s.n - 1), -1)

// Tiempo (ms) de una coordenada x, incluida la proyección a futuro.
timeOf(Ser s, float x) =>
    int res = 0
    if s.cal
        res := int(math.round(x))
    else
        n1 = s.n - 1
        if x >= n1
            res := s.t.get(n1) + int(math.round((x - n1) * s.msBar))
        else if x <= 0
            res := s.t.get(0) + int(math.round(x * s.msBar))
        else
            i0 = int(math.floor(x))
            res := s.t.get(i0) + int(math.round((x - i0) * (s.t.get(i0 + 1) - s.t.get(i0))))
    res

lenDays(Ser s, float lenX) => s.cal ? lenX / 86400000.0 : lenX * s.msBar / 86400000.0
lenBars(Ser s, float lenX) => s.cal ? lenX / math.max(s.msBar, 1.0) : lenX
daysToX(Ser s, float d) => s.cal ? d * 86400000.0 : d * 86400000.0 / math.max(s.msBar, 1.0)

// ════════════════════════════════════════════════════════════════════════════
//  Validación de un pivote proyectado
//  1 = válido (mínimo del ciclo dentro de ±ventana)
//  2 = continuación (mínimo más alto local dentro de ±ventana/2)
//  3 = límite (mínimo del ciclo dentro de ±1.5×ventana, p. ej. 15 %)
//  0 = inválido · -1 = no evaluable (sin datos o ventana sin terminar)
// ════════════════════════════════════════════════════════════════════════════
testPivot(Ser s, float px, float lenX, float winF) =>
    int st = -1
    int tro = -1
    if s.n > 2 and lenX > 0
        xF = xOf(s, 0)
        xL = xOf(s, s.n - 1)
        wX = winF * lenX
        if px - wX >= xF and px + wX <= xL
            lo = bCeil(s, px - wX)
            hi = bFloor(s, px + wX)
            if lo <= hi
                mw = qMin(s, bCeil(s, px - lenX / 3.0), bFloor(s, px + lenX / 3.0))
                m = qMin(s, lo, hi)
                if m == mw
                    st := 1
                    tro := m
                else
                    lo5 = bCeil(s, px - wX * 0.5)
                    hi5 = bFloor(s, px + wX * 0.5)
                    m5 = lo5 <= hi5 ? qMin(s, lo5, hi5) : -1
                    bool cont = false
                    if m5 >= 0
                        x5 = xOf(s, m5)
                        cont := qMin(s, bCeil(s, x5 - lenX / 6.0), bFloor(s, x5 + lenX / 6.0)) == m5
                    if cont
                        st := 2
                        tro := m5
                    else
                        m15 = qMin(s, bCeil(s, px - wX * 1.5), bFloor(s, px + wX * 1.5))
                        if m15 >= 0 and m15 == mw
                            st := 3
                            tro := m15
                        else
                            st := 0
                            tro := m
    [st, tro]

// Evaluación rápida de un grado (para elegir anclas y subdivisión).
evalLvl(Ser s, float x0, float lenX, float winF, float exA, float exB) =>
    float sc = 0.0
    int va = 0
    int te = 0
    if lenX > 0 and s.n > 2
        xF = xOf(s, 0)
        xL = xOf(s, s.n - 1)
        kMin = int(math.ceil((xF - x0) / lenX))
        kMax = int(math.floor((xL - x0) / lenX))
        if kMax >= kMin
            for k = kMin to kMax
                pxk = x0 + k * lenX
                if math.abs(pxk - exA) > lenX * 0.02 and math.abs(pxk - exB) > lenX * 0.02
                    [stt, tro] = testPivot(s, pxk, lenX, winF)
                    if stt >= 0
                        te += 1
                        if stt == 1
                            va += 1
                            sc += 1.0
                        else if stt == 2
                            va += 1
                            sc += 0.85
                        else if stt == 3
                            sc += 0.5
    [sc, va, te]

// Análisis completo de un grado: guarda cada pivote, su estado y el próximo pivote.
analyze(Ser s, Lvl L, float x0, float winF, float exA, float exB) =>
    L.px.clear()
    L.st.clear()
    L.tro.clear()
    L.valid := 0
    L.tested := 0
    L.score := 0.0
    L.st1 := -1
    L.st2 := -1
    L.lastTr := -1
    L.lastPx := na
    L.nextPx := na
    L.active := false
    if L.on and L.len > 0 and s.n > 2
        lenX = L.len
        xF = xOf(s, 0)
        xL = xOf(s, s.n - 1)
        wX = winF * lenX
        kMin = int(math.ceil((xF - x0) / lenX))
        kMax = int(math.floor((xL - x0) / lenX)) + 1
        if kMax >= kMin
            for k = kMin to kMax
                pxk = x0 + k * lenX
                if pxk + wX > xL
                    if na(L.nextPx)
                        L.nextPx := pxk
                        L.active := xL >= pxk - wX
                else
                    [stt, tro] = testPivot(s, pxk, lenX, winF)
                    isAnchor = math.abs(pxk - exA) <= lenX * 0.02 or math.abs(pxk - exB) <= lenX * 0.02
                    L.px.push(pxk)
                    L.st.push(stt)
                    L.tro.push(tro)
                    if stt >= 0
                        if not isAnchor
                            L.tested := L.tested + 1
                            if stt == 1
                                L.valid := L.valid + 1
                                L.score := L.score + 1.0
                            else if stt == 2
                                L.valid := L.valid + 1
                                L.score := L.score + 0.85
                            else if stt == 3
                                L.score := L.score + 0.5
                        L.st2 := L.st1
                        L.st1 := stt
                        if stt == 1 or stt == 2
                            L.lastTr := tro
                            L.lastPx := pxk
        if na(L.nextPx)
            L.nextPx := x0 + (kMax + 1) * lenX
    L.tested

// ════════════════════════════════════════════════════════════════════════════
//  Anclas automáticas: mínimos mayores por prominencia
// ════════════════════════════════════════════════════════════════════════════
findCands(Ser s, int p, int K, bool merge, float tolPct) =>
    n = s.n
    swI = array.new<int>()
    if n > 2 * p + 2
        for i = int(p / 2) to n - 1 - p
            if qMin(s, i - p, i + p) == i
                swI.push(i)
    m = swI.size()
    prom = array.new<float>(m, 0.0)
    if m > 0
        for j = 0 to m - 1
            i = swI.get(j)
            li = s.l.get(i)
            int lb = -1
            if j > 0
                for q = j - 1 to 0
                    if s.l.get(swI.get(q)) < li
                        lb := swI.get(q)
                        break
            int rb = -1
            if j < m - 1
                for q = j + 1 to m - 1
                    if s.l.get(swI.get(q)) < li
                        rb := swI.get(q)
                        break
            lMax = s.h.get(qMax(s, lb < 0 ? 0 : lb, i))
            rMax = s.h.get(qMax(s, i, rb < 0 ? n - 1 : rb))
            float key = 0.0
            if lb >= 0 and rb >= 0
                key := math.min(lMax, rMax)
            else if lb >= 0
                key := lMax
            else if rb >= 0
                key := rMax
            else
                key := math.max(lMax, rMax)
            prom.set(j, li > 0 and key > 0 ? math.log(key / li) : key - li)
    // Los K mínimos más prominentes, ordenados en el tiempo.
    selJ = array.new<int>()
    used = array.new<bool>(m, false)
    if m > 0
        for rep = 1 to math.min(K, m)
            float best = -1e18
            int bj = -1
            for j = 0 to m - 1
                if not used.get(j) and prom.get(j) > best
                    best := prom.get(j)
                    bj := j
            if bj >= 0
                used.set(bj, true)
                selJ.push(bj)
    selJ.sort(order.ascending)
    cX = array.new<float>()
    cI = array.new<int>()
    cP = array.new<float>()
    ns = selJ.size()
    int qq = 0
    while qq < ns
        j1 = selJ.get(qq)
        i1 = swI.get(j1)
        bool merged = false
        if merge and qq < ns - 1
            j2 = selJ.get(qq + 1)
            i2 = swI.get(j2)
            l1 = s.l.get(i1)
            l2 = s.l.get(i2)
            if l1 > 0 and l2 > 0 and math.abs(math.log(l1 / l2)) <= tolPct / 100.0 and i2 - i1 <= 4 * p
                // Mínimo doble: la guía usa el punto medio para capturar el ritmo.
                cX.push((xOf(s, i1) + xOf(s, i2)) / 2.0)
                cI.push(int(math.round((i1 + i2) / 2.0)))
                cP.push(math.max(prom.get(j1), prom.get(j2)))
                merged := true
                qq += 2
        if not merged
            cX.push(xOf(s, i1))
            cI.push(i1)
            cP.push(prom.get(j1))
            qq += 1
    [cX, cI, cP]

// Prueba todos los pares de mínimos mayores y las subdivisiones 2/3/5 → 2/3.
// Puntaje = acierto N1 + acierto N2 (con confianza por muestra) + prominencia − penalizaciones.
selectCycle(Ser s, array<float> cX, array<int> cI, array<float> cP, float winF, int minBars, float minMastPct, array<int> o1, array<int> o2) =>
    float bestS = -1e18
    float bx0 = na
    float bD = na
    int br1 = 2
    int br2 = 2
    int ba = -1
    int bb = -1
    m = cX.size()
    maxP = m > 0 ? math.max(cP.max(), 1e-9) : 1.0
    minD = math.max(minBars * 4, int(math.round(s.n * minMastPct / 100.0)))
    if m >= 2
        for a = 0 to m - 2
            for b = a + 1 to m - 1
                dB = cI.get(b) - cI.get(a)
                if dB >= minD
                    D = cX.get(b) - cX.get(a)
                    float pen0 = 0.0
                    if b - a > 1
                        for c = a + 1 to b - 1
                            if cP.get(c) > math.min(cP.get(a), cP.get(b))
                                pen0 := 0.05
                    promN = (cP.get(a) + cP.get(b)) / (2.0 * maxP)
                    for r1 in o1
                        for r2 in o2
                            if dB * 1.0 / (r1 * r2) >= minBars
                                [s1, v1, t1] = evalLvl(s, cX.get(a), D / r1, winF, cX.get(a), cX.get(b))
                                [s2, v2, t2] = evalLvl(s, cX.get(a), D / r1 / r2, winF, cX.get(a), cX.get(b))
                                sc = 0.45 * lvlScore(s1, t1) + 0.45 * lvlScore(s2, t2) + 0.10 * promN - ratioPen(r1) - 0.5 * ratioPen(r2) - pen0
                                if sc > bestS
                                    bestS := sc
                                    bx0 := cX.get(a)
                                    bD := D
                                    br1 := r1
                                    br2 := r2
                                    ba := a
                                    bb := b
    [ba >= 0, bx0, bD, br1, br2, ba, bb]

// Mejor subdivisión para anclas fijas (modo manual).
pickRatios(Ser s, float x0, float D, float winF, int minBars, array<int> o1, array<int> o2) =>
    float bs = -1e18
    int b1 = 2
    int b2 = 2
    for r1 in o1
        for r2 in o2
            if lenBars(s, D) / (r1 * r2) >= minBars
                [s1, v1, t1] = evalLvl(s, x0, D / r1, winF, x0, x0 + D)
                [s2, v2, t2] = evalLvl(s, x0, D / r1 / r2, winF, x0, x0 + D)
                sc = 0.5 * lvlScore(s1, t1) + 0.5 * lvlScore(s2, t2) - ratioPen(r1) - 0.5 * ratioPen(r2)
                if sc > bs
                    bs := sc
                    b1 := r1
                    b2 := r2
    [b1, b2]

// Motor completo sobre una serie: anclas → subdivisión → 4 grados analizados.
// Devuelve [ok, x0, exA, exB, índice dominante].
runEngine(Ser s, array<Lvl> LV, bool manual, int t1, int t2, float winF) =>
    bool ok = false
    float x0 = na
    float exA = na
    float exB = na
    int dom = -1
    n = s.n
    if n >= 60
        p = iPivStr > 0 ? iPivStr : math.max(2, int(math.round(n / 60.0)))
        o1 = optsOf(iR1, true)
        o2 = optsOf(iR2, false)
        o3 = optsOf(iR3, false)
        float D = na
        int r1 = 2
        int r2 = 2
        if manual
            ta1 = math.min(t1, t2)
            ta2 = math.max(t1, t2)
            xa = s.cal ? float(ta1) : float(idxCeilT(s, ta1))
            xb = s.cal ? float(ta2) : float(idxCeilT(s, ta2))
            if xb > xa
                [m1, m2] = pickRatios(s, xa, xb - xa, winF, iMinBars, o1, o2)
                ok := true
                x0 := xa
                D := xb - xa
                r1 := m1
                r2 := m2
                exA := xa
                exB := xb
        else
            [cX, cI, cP] = findCands(s, p, iCand, iMerge, iMergeT)
            [okS, sx0, sD, sr1, sr2, sa, sb] = selectCycle(s, cX, cI, cP, winF, iMinBars, iMinMast, o1, o2)
            if okS
                ok := true
                x0 := sx0
                D := sD
                r1 := sr1
                r2 := sr2
                exA := cX.get(sa)
                exB := cX.get(sb)
        if ok
            // Nivel 3: mejor subdivisión 2/3 del nivel 2.
            int r3 = 2
            float bs3 = -1e18
            for a3 in o3
                l3 = D / r1 / r2 / a3
                if lenBars(s, l3) >= iMinBars
                    [s3, v3, t3] = evalLvl(s, x0, l3, winF, exA, exB)
                    sc3 = lvlScore(s3, t3) - ratioPen(a3)
                    if sc3 > bs3
                        bs3 := sc3
                        r3 := a3
            lens = array.from(D, D / r1, D / r1 / r2, D / r1 / r2 / r3)
            rats = array.from(1, r1, r2, r3)
            for i = 0 to 3
                Lq = LV.get(i)
                Lq.len := lens.get(i)
                Lq.ratio := rats.get(i)
                Lq.on := lenBars(s, Lq.len) >= iMinBars
                analyze(s, Lq, x0, winF, exA, exB)
            // Ciclo dominante = más aciertos directos (con al menos 3 pruebas).
            float domS = -1.0
            for i = 0 to 3
                Lq = LV.get(i)
                if Lq.on and Lq.tested >= 3
                    sv = lvlScore(Lq.score, Lq.tested)
                    if sv > domS
                        domS := sv
                        dom := i
            if dom < 0
                dom := LV.get(1).on ? 1 : 0
    [ok, x0, exA, exB, dom]

// ════════════════════════════════════════════════════════════════════════════
//  Dibujo
// ════════════════════════════════════════════════════════════════════════════
// Cadena de semicírculos (un polyline por grado).
drawArcs(Ser s, float x0, float lenX, float xA, float xB, float yBase, float h, bool lg, color col, string sty, int w) =>
    pts = array.new<chart.point>()
    if lenX > 0 and xB > xA
        int kS = int(math.floor((xA - x0) / lenX))
        int kE = int(math.ceil((xB - x0) / lenX)) - 1
        M = 14
        maxArcs = int(9000 / (M + 1))
        if kE - kS + 1 > maxArcs
            kS := kE - maxArcs + 1
        if kE >= kS
            for k = kS to kE
                a0 = x0 + k * lenX
                for j = 0 to M
                    th = math.pi * j / M
                    xx = a0 + lenX * (1.0 - math.cos(th)) / 2.0
                    yy = yBase + h * math.sin(th)
                    pts.push(chart.point.from_time(timeOf(s, xx), yToP(yy, lg)))
    if pts.size() > 1
        polyline.new(pts, curved = false, closed = false, xloc = xloc.bar_time, line_color = col, line_style = sty, line_width = w)
    pts.size()

vLine(int t, float p1, float p2, color col, string sty, int w) =>
    line.new(t, p1, t, p2, xloc = xloc.bar_time, extend = extend.both, color = col, style = sty, width = w)

hLine(int t1, int t2, float p, color col, string sty, int w) =>
    line.new(t1, p, t2, p, xloc = xloc.bar_time, color = col, style = sty, width = w)

wBox(int tL, int tR, float top, float bot, color bg) =>
    box.new(tL, top, tR, bot, xloc = xloc.bar_time, border_width = 0, bgcolor = bg)

lineY(int i1, float y1, int i2, float y2, int j) => y1 + (y2 - y1) * (j - i1) * 1.0 / math.max(i2 - i1, 1)

// Base y estructura para el checklist de momentum (puntos 1 y 2 de la guía).
momBase(Ser s, int e, int K, float atrE) =>
    bool c1 = false
    bool c2 = false
    if e - K + 1 >= 0 and K >= 5
        lo = qMin(s, e - K + 1, e)
        hi = qMax(s, e - K + 1, e)
        c1 := (e - lo) >= K / 3.0 and (s.h.get(hi) - s.l.get(lo)) <= iBaseAtr * atrE
        q = math.max(2, int(K / 10))
        if lo + q <= e
            c2 := s.c.get(e) > (s.h.get(hi) + s.l.get(lo)) / 2.0 and s.c.get(e) > s.c.get(math.max(e - q, 0))
    [c1, c2]

// ════════════════════════════════════════════════════════════════════════════
//  Datos por barra
// ════════════════════════════════════════════════════════════════════════════
var Ser S = newSer()
var Ser R = newSer()

srcL = iSrc == "Cierre / Close" ? close : iSrc == "HLC3" ? hlc3 : low
srcH = iSrc == "Cierre / Close" ? close : iSrc == "HLC3" ? hlc3 : high

rOn     = iRMode != "Desactivado / Off"
rIsForm = iRMode == "Fórmula / Formula"
rSymReq = rIsForm ? iRForm : iRSym
rReq    = request.security(rOn ? rSymReq : syminfo.tickerid, timeframe.period, close, ignore_invalid_symbol = true)
float rVal = na
if rOn and not na(rReq) and (rIsForm or rReq != 0)
    rVal := iRMode == "Activo ÷ Símbolo / Asset ÷ Symbol" ? close / rReq : iRMode == "Símbolo ÷ Activo / Symbol ÷ Asset" ? (close != 0 ? rReq / close : na) : rReq

if bar_index >= last_bar_index - iMaxBars + 1
    S.t.push(time)
    S.h.push(srcH)
    S.l.push(srcL)
    S.c.push(close)
    if not na(rVal)
        R.t.push(time)
        R.h.push(rVal)
        R.l.push(rVal)
        R.c.push(rVal)

// Momentum (checklist de la guía): EMA 20/50 apiladas y separándose + ATR subiendo + volumen.
emaF  = ta.ema(close, iEmaF)
emaS  = ta.ema(close, iEmaS)
atrV  = ta.atr(iAtrL)
atrMa = ta.sma(atrV, 20)
volF  = ta.sma(volume, 5)
volS  = ta.sma(volume, 20)
emaOk = close > emaF and close > emaS and emaF > emaS and emaF > emaF[3] and emaS > emaS[3] and (emaF - emaS) > (emaF[5] - emaS[5])
atrOk = atrV > atrV[3] and atrV > atrMa
volOk = volS > 0 and volF > volS * 1.1
hasVol = ta.cum(nz(volume)) > 0

plot(iShowEma ? emaF : na, "EMA rápida / Fast EMA", color = iCol1)
plot(iShowEma ? emaS : na, "EMA lenta / Slow EMA", color = iCol2)

// ════════════════════════════════════════════════════════════════════════════
//  Tabla y banderas de alerta
// ════════════════════════════════════════════════════════════════════════════
tblPos = iTblPos == "Arriba derecha / Top right" ? position.top_right : iTblPos == "Abajo derecha / Bottom right" ? position.bottom_right : iTblPos == "Arriba izquierda / Top left" ? position.top_left : position.bottom_left
tblSz  = iTblSize == "Diminuta / Tiny" ? size.tiny : iTblSize == "Normal" ? size.normal : size.small
var table tb = na

var bool fWin   = false
var bool fIdeal = false
var bool fInv   = false
var bool fRedr  = false
var bool fLong  = false
var bool fShort = false
var bool fMom   = false
var bool fSync  = false
var bool fTp    = false
var bool fRatio = false

tCell(table tbl, int c, int r, string s, color tc, color bg) =>
    table.cell(tbl, c, r, s, text_color = tc, bgcolor = bg, text_size = tblSz, text_halign = text.align_left)

rowMsg(table tbl, int r, string s, color tc, color bg) =>
    table.cell(tbl, 0, r, s, text_color = tc, bgcolor = bg, text_size = tblSz, text_halign = text.align_left)
    table.merge_cells(tbl, 0, r, 6, r)

ck(bool b) => b ? "✓" : "✗"

// ════════════════════════════════════════════════════════════════════════════
//  Cálculo principal (última barra)
// ════════════════════════════════════════════════════════════════════════════
if barstate.islast
    fWin   := false
    fIdeal := false
    fInv   := false
    fRedr  := false
    fLong  := false
    fShort := false
    fMom   := false
    fSync  := false
    fTp    := false
    fRatio := false

    // Borrar dibujos de la ejecución anterior.
    aLn = line.all
    if aLn.size() > 0
        for i = 0 to aLn.size() - 1
            line.delete(aLn.get(i))
    aBx = box.all
    if aBx.size() > 0
        for i = 0 to aBx.size() - 1
            box.delete(aBx.get(i))
    aLb = label.all
    if aLb.size() > 0
        for i = 0 to aLb.size() - 1
            label.delete(aLb.get(i))
    aPl = polyline.all
    if aPl.size() > 0
        for i = 0 to aPl.size() - 1
            polyline.delete(aPl.get(i))
    if not na(tb)
        table.delete(tb)
        tb := na
    if iTable
        tb := table.new(tblPos, 7, 22, frame_color = color.new(chart.fg_color, 70), frame_width = 1, border_color = color.new(chart.fg_color, 88), border_width = 1)

    fg    = chart.fg_color
    tBg   = color.new(chart.bg_color, 8)
    hBg   = color.new(chart.fg_color, 88)
    cOk   = #26A69A
    cWarn = #FFA726
    cBad  = #EF5350
    winF  = iWin / 100.0
    useCal = iBase == "Calendario / Calendar" ? true : iBase == "Barras / Bars" ? false : (not timeframe.isintraday or syminfo.type == "crypto")
    n = buildSer(S, useCal)

    LV = array.new<Lvl>()
    for i = 0 to 3
        LV.push(newLvl(i))
    [ok, x0, exA, exB, dom] = runEngine(S, LV, iAnchor == "Manual", iT1, iT2, winF)

    if not ok
        if iTable
            rowMsg(tb, 0, txt("Ciclos de Tiempo: datos insuficientes o sin par de mínimos válido. Pruebe más barras, otra fuerza de pivote o anclas manuales.", "Time Cycles: not enough data or no valid pair of lows. Try more bars, another pivot strength or manual anchors."), fg, tBg)
    else
        cols    = array.from(iCol0, iCol1, iCol2, iCol3)
        shows   = array.from(iShow0, iShow1, iShow2, iShow3)
        hFac    = array.from(1.0, 0.62, 0.40, 0.24)
        widths  = array.from(2, 2, 1, 1)
        xF = xOf(S, 0)
        xL = xOf(S, n - 1)
        xP = xOf(S, n - 2)
        D  = LV.get(0).len

        // Nivel de trading.
        int tI = iTL == "Madre / Master" ? 0 : iTL == "N1 / L1" ? 1 : iTL == "N2 / L2" ? 2 : iTL == "N3 / L3" ? 3 : dom
        if not LV.get(tI).on
            tI := dom
        T    = LV.get(tI)
        lenT = T.len
        wXT  = winF * lenT
        lbT  = lenBars(S, lenT)

        // Geometría del rango visible.
        int vL = 0
        int vR = n - 1
        if iFit and not na(chart.left_visible_bar_time) and not na(chart.right_visible_bar_time)
            vL := math.min(idxCeilT(S, chart.left_visible_bar_time), n - 1)
            vR := math.max(idxCeilT(S, chart.right_visible_bar_time + 1.0) - 1, vL)
        vLo  = S.l.get(qMin(S, vL, vR))
        vHi  = S.h.get(qMax(S, vL, vR))
        lg   = iLog and vLo > 0 and S.l.min() > 0
        yLo  = pToY(vLo, lg)
        yHi  = pToY(vHi, lg)
        span = math.max(yHi - yLo, 1e-9)
        yBase = yLo - span * 0.03
        pBase = yToP(yBase, lg)
        pTop  = yToP(yHi + span * 0.02, lg)
        xA = xOf(S, vL)
        xB = xL + iProj * D

        // ─── Arcos, líneas de pivote, próximas fechas y ventanas por grado
        for i = 0 to 3
            Lq = LV.get(i)
            if Lq.on and shows.get(i)
                col = cols.get(i)
                h = span * iArcH / 100.0 * hFac.get(i)
                drawArcs(S, x0, Lq.len, xA, xB, yBase, h, lg, col, line.style_solid, widths.get(i))
                if i <= 2
                    kS = int(math.ceil((xA - x0) / Lq.len))
                    kE = int(math.floor((xB - x0) / Lq.len))
                    if kE >= kS
                        int cnt = 0
                        for k = kE to kS
                            if cnt < 120
                                vLine(timeOf(S, x0 + k * Lq.len), pBase, pTop, color.new(col, i == tI ? 55 : 75), line.style_dotted, 1)
                                cnt += 1
                // Próximo pivote: ventana al pie del arco + etiqueta.
                wX = winF * Lq.len
                nx = Lq.nextPx
                wBox(timeOf(S, nx - wX), timeOf(S, nx + wX), yToP(yBase + h * 0.30, lg), pBase, color.new(col, Lq.active ? 55 : 78))
                tip = lvName(i) + " · " + txt("ventana ", "window ") + fmtT(timeOf(S, nx - wX)) + " → " + fmtT(timeOf(S, nx + wX))
                label.new(timeOf(S, nx), pBase, lvName(i) + " " + fmtT(timeOf(S, nx)), xloc = xloc.bar_time, color = color.new(col, 15), textcolor = color.black, style = label.style_label_up, size = size.tiny, tooltip = tip)

        // Diana 5/10/15 % en el próximo pivote del nivel de trading.
        if iBull and T.on
            nx = T.nextPx
            wBox(timeOf(S, nx - wXT * 1.5), timeOf(S, nx + wXT * 1.5), pTop, pBase, color.new(#8B6B4A, 90))
            wBox(timeOf(S, nx - wXT), timeOf(S, nx + wXT), pTop, pBase, color.new(fg, 92))
            wBox(timeOf(S, nx - wXT * 0.5), timeOf(S, nx + wXT * 0.5), pTop, pBase, color.new(#E6B422, T.active ? 78 : 88))

        // Entra / sale dinero en el ciclo de trading en curso.
        if iMoney and T.on
            cs = T.nextPx - lenT
            hT = span * iArcH / 100.0 * hFac.get(tI)
            label.new(timeOf(S, cs + lenT * 0.25), yToP(yBase + hT * 0.75, lg), txt("Entra dinero ↗", "Money in ↗"), xloc = xloc.bar_time, style = label.style_none, textcolor = color.new(cols.get(tI), 10), size = size.tiny)
            label.new(timeOf(S, cs + lenT * 0.75), yToP(yBase + hT * 0.75, lg), txt("Sale dinero ↘", "Money out ↘"), xloc = xloc.bar_time, style = label.style_none, textcolor = color.new(cols.get(tI), 10), size = size.tiny)

        // ─── Marcas de acierto
        if iMarks != "Ninguno / None"
            int nMarks = 0
            for i = 0 to 3
                Lq = LV.get(i)
                if Lq.on and (iMarks == "Todos / All" or i == tI) and Lq.px.size() > 0
                    for q = Lq.px.size() - 1 to 0
                        pq = Lq.px.get(q)
                        sq = Lq.st.get(q)
                        tq = Lq.tro.get(q)
                        if pq >= xA and sq >= 0 and tq >= 0 and nMarks < 250
                            dev = lenDays(S, xOf(S, tq) - pq)
                            stTxt = sq == 1 ? txt("válido", "valid") : sq == 2 ? txt("continuación", "continuation") : sq == 3 ? txt("límite ±15%", "limit ±15%") : txt("inválido", "invalid")
                            tipM = lvName(i) + " · " + stTxt + "\n" + txt("ideal: ", "ideal: ") + fmtT(timeOf(S, pq)) + "\n" + txt("real: ", "actual: ") + fmtT(S.t.get(tq)) + "\n" + txt("desvío: ", "deviation: ") + (dev >= 0 ? "+" : "") + fmtDays(dev)
                            if sq == 0
                                label.new(timeOf(S, pq), na, "✗", xloc = xloc.bar_time, yloc = yloc.belowbar, style = label.style_none, textcolor = cBad, size = size.small, tooltip = tipM)
                            else
                                mc = sq == 1 ? cOk : sq == 2 ? #42A5F5 : cWarn
                                label.new(S.t.get(tq), na, "", xloc = xloc.bar_time, yloc = yloc.belowbar, style = label.style_circle, color = color.new(mc, 0), size = size.tiny, tooltip = tipM)
                            nMarks += 1

        // ─── Pivote fantasma (2 invalidaciones seguidas) y ciclos desplazados
        string redrawTxt = ""
        for i = 0 to 3
            Lq = LV.get(i)
            if Lq.on and Lq.st1 == 0 and Lq.st2 == 0
                redrawTxt := redrawTxt + (redrawTxt == "" ? "" : ", ") + lvName(i)
                if iGhost and shows.get(i)
                    gm = qMin(S, bCeil(S, xL - Lq.len), n - 1)
                    if gm >= 0 and (n - 1 - gm) >= math.max(2, int(lenBars(S, Lq.len) * 0.1))
                        gpx = xOf(S, gm) + Lq.len
                        gw = winF * Lq.len
                        vLine(timeOf(S, gpx), pBase, pTop, color.new(#C77DFF, 30), line.style_dashed, 1)
                        wBox(timeOf(S, gpx - gw), timeOf(S, gpx + gw), yToP(yBase + span * 0.06, lg), pBase, color.new(#C77DFF, 75))
                        label.new(timeOf(S, gpx), pTop, txt("Fantasma ", "Ghost ") + lvName(i) + " " + fmtT(timeOf(S, gpx)), xloc = xloc.bar_time, style = label.style_label_down, color = color.new(#C77DFF, 20), textcolor = color.white, size = size.tiny, tooltip = txt("Dos pivotes seguidos inválidos: la guía recomienda redibujar. Pivote propuesto desde el último mínimo real.", "Two invalid pivots in a row: the guide recommends redrawing. Proposed pivot from the latest actual low."))

        if iShift
            // Desfase del último pivote válido del nivel superior (N1, o Madre) aplicado a N2/N3 (ejemplo XMR).
            Lp = LV.get(1).on and LV.get(1).lastTr >= 0 ? LV.get(1) : LV.get(0)
            if Lp.lastTr >= 0 and xL - Lp.lastPx <= 2.0 * Lp.len
                dev = xOf(S, Lp.lastTr) - Lp.lastPx
                for i = 2 to 3
                    Lq = LV.get(i)
                    if Lq.on and shows.get(i) and math.abs(dev) >= 0.5 * winF * Lq.len
                        h = span * iArcH / 100.0 * hFac.get(i)
                        drawArcs(S, x0 + dev, Lq.len, math.max(xA, xOf(S, Lp.lastTr)), xB, yBase, h, lg, color.new(cols.get(i), 35), line.style_dotted, 1)

        // ─── Ciclos nominales de Hurst tras un mínimo extremo (hasta 20W)
        string hurstTxt = ""
        int hurstAct = 0
        if iHurst
            p0 = iPivStr > 0 ? iPivStr : math.max(2, int(math.round(n / 60.0)))
            [hX, hI, hP] = findCands(S, p0, iCand, false, iMergeT)
            spanX = daysToX(S, 154.0)
            float ha = na
            if hX.size() > 0
                mx = hP.max()
                for q = hX.size() - 1 to 0
                    if na(ha) and hP.get(q) >= 0.5 * mx and xL - hX.get(q) <= spanX
                        ha := hX.get(q)
            if not na(ha)
                hDays = array.from(5.0, 10.0, 20.0, 40.0, 80.0, 140.0)
                hNames = array.from("5D", "10D", "20D", "40D", "80D", "20W")
                hurstTxt := txt("desde ", "since ") + fmtT(timeOf(S, ha)) + ":"
                for q = 0 to 5
                    hl = daysToX(S, hDays.get(q))
                    if lenBars(S, hl) >= iMinBars
                        hw = winF * hl
                        int kk = math.max(1, int(math.floor((xL - ha) / hl)))
                        while ha + kk * hl + hw <= xL
                            kk += 1
                        hpx = ha + kk * hl
                        if hpx - ha <= spanX
                            act = xL >= hpx - hw
                            hurstAct += act ? 1 : 0
                            hurstTxt := hurstTxt + " " + hNames.get(q) + (act ? "●" : "")
                            vLine(timeOf(S, hpx), pBase, pTop, color.new(iColH, 45), line.style_dashed, 1)
                            wBox(timeOf(S, hpx - hw), timeOf(S, hpx + hw), yToP(yBase + span * 0.04, lg), pBase, color.new(iColH, 70))
                            label.new(timeOf(S, hpx), pTop, "H·" + hNames.get(q), xloc = xloc.bar_time, style = label.style_label_down, color = color.new(iColH, 25), textcolor = color.white, size = size.tiny, tooltip = txt("Ciclo común de Hurst desde mínimo extremo · ventana ±", "Hurst common cycle from extreme low · window ±") + fmtDays(lenDays(S, hw)))

        // ─── VTL y señales (nivel de trading)
        sgBar = array.new<int>()
        sgDir = array.new<int>()
        sgE   = array.new<float>()
        sgS   = array.new<float>()
        lgp = iLog and S.l.min() > 0
        int upI1 = -1
        int upI2 = -1
        int dnI1 = -1
        int dnI2 = -1
        np = T.px.size()
        if T.on and np > 0
            // Cortos: cruce bajo la VTL que une dos mínimos consecutivos del mismo grado.
            if np > 1
                for q = 1 to np - 1
                    s0 = T.st.get(q - 1)
                    s1 = T.st.get(q)
                    i1 = T.tro.get(q - 1)
                    i2 = T.tro.get(q)
                    if (s0 == 1 or s0 == 2) and (s1 == 1 or s1 == 2) and i2 > i1 and i1 >= 0
                        upI1 := i1
                        upI2 := i2
                        y1 = pToY(S.l.get(i1), lgp)
                        y2 = pToY(S.l.get(i2), lgp)
                        jEnd = q + 1 < np ? bFloor(S, T.px.get(q + 1) + wXT) : n - 1
                        if i2 + 2 <= jEnd
                            for j = i2 + 2 to jEnd
                                cy = pToY(S.c.get(j), lgp)
                                cyp = pToY(S.c.get(j - 1), lgp)
                                if cy < lineY(i1, y1, i2, y2, j) and cyp >= lineY(i1, y1, i2, y2, j - 1) and qMax(S, i2, j) > i2 + 1
                                    sgBar.push(j)
                                    sgDir.push(-1)
                                    sgE.push(S.c.get(j))
                                    sgS.push(S.h.get(qMax(S, i2, j)))
                                    break
            // Largos: ruptura de la línea bajista del ciclo dentro de la ventana del pivote.
            pivs = array.copy(T.px)
            pivs.push(T.nextPx)
            for q = 0 to pivs.size() - 1
                pq = pivs.get(q)
                ws = bCeil(S, pq - wXT)
                if ws >= 2 and ws <= n - 1
                    top = qMax(S, bCeil(S, pq - lenT + wXT), ws - 1)
                    qb = math.max(2, int(math.round(lbT / 10.0)))
                    if top >= 0 and top + qb <= ws - 1
                        sec = qMax(S, top + qb, ws - 1)
                        if sec > top and S.h.get(sec) < S.h.get(top)
                            dnI1 := top
                            dnI2 := sec
                            y1 = pToY(S.h.get(top), lgp)
                            y2 = pToY(S.h.get(sec), lgp)
                            jEnd = math.min(n - 1, bFloor(S, pq + 0.25 * lenT))
                            if ws <= jEnd
                                for j = ws to jEnd
                                    cy = pToY(S.c.get(j), lgp)
                                    cyp = pToY(S.c.get(j - 1), lgp)
                                    if cy > lineY(top, y1, sec, y2, j) and cyp <= lineY(top, y1, sec, y2, j - 1)
                                        sgBar.push(j)
                                        sgDir.push(1)
                                        sgE.push(S.c.get(j))
                                        sgS.push(S.l.get(qMin(S, bCeil(S, pq - 1.5 * wXT), j)))
                                        break

        // Dibujo de las VTL activas.
        if iVtl and T.on
            if upI1 >= 0
                line.new(S.t.get(upI1), S.l.get(upI1), S.t.get(upI2), S.l.get(upI2), xloc = xloc.bar_time, extend = extend.right, color = color.new(iColDn, 20), width = 1)
                label.new(S.t.get(upI2), S.l.get(upI2), "VTL " + lvName(tI), xloc = xloc.bar_time, style = label.style_label_upper_left, color = color.new(iColDn, 100), textcolor = iColDn, size = size.tiny, tooltip = txt("Cruce por debajo = techo del ciclo confirmado (gatillo corto, objetivo mínimo 1:1).", "Cross below = cycle top confirmed (short trigger, minimum target 1:1)."))
            if dnI1 >= 0
                line.new(S.t.get(dnI1), S.h.get(dnI1), S.t.get(dnI2), S.h.get(dnI2), xloc = xloc.bar_time, extend = extend.right, color = color.new(iColUp, 20), width = 1, style = line.style_dashed)
                label.new(S.t.get(dnI2), S.h.get(dnI2), txt("Bajista ", "Down ") + lvName(tI), xloc = xloc.bar_time, style = label.style_label_lower_left, color = color.new(iColUp, 100), textcolor = iColUp, size = size.tiny, tooltip = txt("Ruptura al alza dentro de la ventana del pivote = gatillo largo (objetivo mínimo 1:1).", "Upside break inside the pivot window = long trigger (minimum target 1:1)."))

        // Señales: historial + niveles de la última señal.
        int lastSig = -1
        if sgBar.size() > 0
            for q = 0 to sgBar.size() - 1
                if lastSig < 0
                    lastSig := q
                else if sgBar.get(q) > sgBar.get(lastSig)
                    lastSig := q
            for q = 0 to sgBar.size() - 1
                j = sgBar.get(q)
                dir = sgDir.get(q)
                if iSigHist and j >= vL
                    eY = pToY(sgE.get(q), lgp)
                    sY = pToY(sgS.get(q), lgp)
                    rk = math.abs(eY - sY)
                    tp1 = yToP(eY + dir * rk, lgp)
                    tipS = (dir > 0 ? txt("LARGO", "LONG") : txt("CORTO", "SHORT")) + " · " + fmtT(S.t.get(j)) + "\n" + txt("Entrada: ", "Entry: ") + str.tostring(sgE.get(q), format.mintick) + "\nSL: " + str.tostring(sgS.get(q), format.mintick) + "\nTP 1:1: " + str.tostring(tp1, format.mintick)
                    label.new(S.t.get(j), na, dir > 0 ? "▲" : "▼", xloc = xloc.bar_time, yloc = dir > 0 ? yloc.belowbar : yloc.abovebar, style = label.style_none, textcolor = dir > 0 ? iColUp : iColDn, size = size.normal, tooltip = tipS)
            if iTrade
                j = sgBar.get(lastSig)
                dir = sgDir.get(lastSig)
                eY = pToY(sgE.get(lastSig), lgp)
                sY = pToY(sgS.get(lastSig), lgp)
                rk = math.abs(eY - sY)
                tA = S.t.get(j)
                tB = timeOf(S, xOf(S, j) + 0.5 * lenT)
                cT = dir > 0 ? iColUp : iColDn
                hLine(tA, tB, sgE.get(lastSig), color.new(fg, 20), line.style_solid, 1)
                hLine(tA, tB, sgS.get(lastSig), color.new(cBad, 10), line.style_solid, 1)
                label.new(tB, sgS.get(lastSig), "SL " + str.tostring(sgS.get(lastSig), format.mintick), xloc = xloc.bar_time, style = label.style_label_left, color = color.new(cBad, 80), textcolor = fg, size = size.tiny)
                exts = array.from(1.0, 1.618, 2.272)
                extN = array.from("1:1", "1.618", "2.272")
                for q = 0 to 2
                    pT = yToP(eY + dir * rk * exts.get(q), lgp)
                    hLine(tA, tB, pT, color.new(cT, 10 + q * 20), line.style_dashed, 1)
                    label.new(tB, pT, "TP " + extN.get(q) + " · " + str.tostring(pT, format.mintick), xloc = xloc.bar_time, style = label.style_label_left, color = color.new(cT, 80), textcolor = fg, size = size.tiny)
                if j == n - 1
                    fLong := dir > 0
                    fShort := dir < 0

        // ─── Estadística de pivotes (expansión, día del techo, retroceso, traslación)
        exps  = array.new<float>()
        tops  = array.new<float>()
        rets  = array.new<float>()
        trans = array.new<float>()
        if T.on and np > 0
            for q = 0 to np - 1
                sq = T.st.get(q)
                i0 = T.tro.get(q)
                if (sq == 1 or sq == 2) and i0 >= 0 and S.l.get(i0) > 0
                    xi = xOf(S, i0)
                    if xi + 0.9 * lenT <= xL
                        e75 = bFloor(S, xi + 0.75 * lenT)
                        top = qMax(S, i0, e75)
                        if top >= 0
                            exps.push(S.h.get(top) / S.l.get(i0) - 1.0)
                            tops.push((xOf(S, top) - xi) / lenT)
                            re = math.min(bFloor(S, xOf(S, top) + 0.25 * lenT), bFloor(S, xi + 0.9 * lenT))
                            den = S.h.get(top) - S.l.get(i0)
                            if re > top and den > 0
                                ml = qMin(S, top + 1, re)
                                rets.push((S.h.get(top) - S.l.get(ml)) / den)
                            full = qMax(S, i0, bFloor(S, xi + lenT))
                            trans.push((xOf(S, full) - xi) / lenT)
        nS = exps.size()
        bool statsOk = nS >= iStatMin
        float tp1P = na
        float tp2P = na
        float tp3P = na
        float tpq1 = na
        float tpq3 = na
        float tpMed = na
        float retMed = na
        int nTp2 = 0
        float leftPct = na
        if statsOk
            tp1P := exps.min()
            tp2P := exps.percentile_nearest_rank(10)
            tp3P := exps.median()
            tpq1 := tops.percentile_nearest_rank(25)
            tpq3 := tops.percentile_nearest_rank(75)
            tpMed := tops.median()
            retMed := rets.size() > 0 ? rets.median() : na
            int nl = 0
            for q = 0 to nS - 1
                nTp2 += exps.get(q) >= tp2P ? 1 : 0
            for q = 0 to trans.size() - 1
                nl += trans.get(q) < 0.45 ? 1 : 0
            leftPct := nl * 1.0 / trans.size()

        // Base del ciclo en curso: mínimo dentro de la ventana activa o último mínimo válido.
        int baseI = -1
        if T.on
            if T.active
                wsA = bCeil(S, T.nextPx - wXT)
                if wsA <= n - 1
                    baseI := qMin(S, wsA, n - 1)
            else if T.lastTr >= 0 and xOf(S, T.lastTr) + lenT > xL
                baseI := T.lastTr
        float curExp = na
        string strength = "—"
        if baseI >= 0 and S.l.get(baseI) > 0
            curExp := S.h.get(qMax(S, baseI, n - 1)) / S.l.get(baseI) - 1.0
            if statsOk
                el = (xL - xOf(S, baseI)) / lenT
                strength := curExp >= tp3P ? txt("fuerte (≥ mediana)", "strong (≥ median)") : el > tpMed and curExp < tp1P ? txt("débil (bajo el mínimo histórico)", "weak (below historical minimum)") : txt("normal", "normal")
            if iStats and statsOk
                bP = S.l.get(baseI)
                tA = S.t.get(baseI)
                tB = timeOf(S, xOf(S, baseI) + 0.75 * lenT)
                tps  = array.from(tp1P, tp2P, tp3P)
                tpN  = array.from(txt("TP1 mín.", "TP1 min"), "TP2 90%", txt("TP3 mediana", "TP3 median"))
                tpC  = array.from(str.tostring(nS) + "/" + str.tostring(nS), str.tostring(nTp2) + "/" + str.tostring(nS), "50%")
                for q = 0 to 2
                    pT = bP * (1.0 + tps.get(q))
                    hLine(tA, tB, pT, color.new(cOk, 15 + q * 15), line.style_dotted, 1)
                    label.new(tB, pT, tpN.get(q) + " " + fmtPct(tps.get(q)) + " (" + tpC.get(q) + ")", xloc = xloc.bar_time, style = label.style_label_left, color = color.new(cOk, 82), textcolor = fg, size = size.tiny)
                    prevMax = baseI <= n - 2 ? S.h.get(qMax(S, baseI, n - 2)) : bP
                    if S.h.get(n - 1) >= pT and prevMax < pT
                        fTp := true
                // Zona temporal típica del techo local.
                wBox(timeOf(S, xOf(S, baseI) + tpq1 * lenT), timeOf(S, xOf(S, baseI) + tpq3 * lenT), bP * (1.0 + tp3P), bP, color.new(cOk, 90))
                label.new(timeOf(S, xOf(S, baseI) + tpMed * lenT), bP * (1.0 + tp3P), txt("Techo típico", "Typical top"), xloc = xloc.bar_time, style = label.style_label_down, color = color.new(cOk, 70), textcolor = fg, size = size.tiny)
                // Retroceso típico desde TP2 (la guía: demanda en ~0.382).
                if not na(retMed)
                    p2 = bP * (1.0 + tp2P)
                    pr = p2 - retMed * (p2 - bP)
                    hLine(tA, tB, pr, color.new(#42A5F5, 20), line.style_dashed, 1)
                    label.new(tB, pr, txt("Retroceso típico ", "Typical retrace ") + str.tostring(retMed, "#.###"), xloc = xloc.bar_time, style = label.style_label_left, color = color.new(#42A5F5, 82), textcolor = fg, size = size.tiny)

        // ─── Ratio: mismo motor sobre la serie ratio
        RL = array.new<Lvl>()
        for i = 0 to 3
            RL.push(newLvl(i))
        bool rOk = false
        int rDom = -1
        bool rAct = false
        bool rDemand = false
        string rTxt = txt("desactivado", "off")
        if rOn
            nR = buildSer(R, useCal)
            if nR >= 60
                [okR, rx0, rA, rB, rd] = runEngine(R, RL, false, iT1, iT2, winF)
                if okR
                    rOk := true
                    rDom := rd
                    RD = RL.get(rd)
                    rAct := RD.active
                    rLb = math.max(5, int(lenBars(R, RD.len)))
                    rlo = qMin(R, nR - rLb, nR - 1)
                    rhi = qMax(R, nR - rLb, nR - 1)
                    rng = R.h.get(rhi) - R.l.get(rlo)
                    rDemand := rng > 0 and (R.c.get(nR - 1) - R.l.get(rlo)) / rng <= 0.30 and nR > 3 and R.c.get(nR - 1) > R.c.get(nR - 4)
                    rw = winF * RD.len
                    rnx = RD.nextPx
                    wBox(timeOf(R, rnx - rw), timeOf(R, rnx + rw), pBase, yToP(yBase - span * 0.025, lg), color.new(iColH, rAct ? 40 : 65))
                    label.new(timeOf(R, rnx), yToP(yBase - span * 0.025, lg), "R " + lvName(rd), xloc = xloc.bar_time, style = label.style_label_up, color = color.new(iColH, 20), textcolor = color.white, size = size.tiny, tooltip = txt("Próximo pivote del ratio · ", "Next ratio pivot · ") + fmtT(timeOf(R, rnx)))
                    rTxt := lvName(rd) + " · " + str.tostring(RD.valid) + "/" + str.tostring(RD.tested) + " · " + txt("próx. ", "next ") + fmtT(timeOf(R, rnx)) + (rAct ? txt(" · EN VENTANA", " · IN WINDOW") : "") + (rDemand ? txt(" · en demanda", " · at demand") : "")
                    xRL = xOf(R, nR - 1)
                    xRP = xOf(R, nR - 2)
                    fRatio := xRL >= rnx - rw and xRP < rnx - rw
                else
                    rTxt := txt("sin ciclo válido", "no valid cycle")
            else
                rTxt := txt("sin datos (revise el símbolo)", "no data (check the symbol)")

        // ─── Momentum: checklist de 5 puntos
        int Kb = timeframe.in_seconds() >= 86400 ? math.max(5, int(math.round(iBaseD * 86400.0 / timeframe.in_seconds()))) : math.max(5, int(math.round(lbT * 0.5)))
        Kb := math.min(Kb, n - 2)
        [m1, m2] = momBase(S, n - 1, Kb, atrV)
        [m1p, m2p] = momBase(S, n - 2, Kb, atrV[1])
        m3 = emaOk and atrOk
        m3p = emaOk[1] and atrOk[1]
        m4 = rOk and (rAct or rDemand)
        m5 = hasVol and volOk
        m5p = hasVol and volOk[1]
        momMax = 3 + (rOn ? 1 : 0) + (hasVol ? 1 : 0)
        momSc = (m1 ? 1 : 0) + (m2 ? 1 : 0) + (m3 ? 1 : 0) + (m4 ? 1 : 0) + (m5 ? 1 : 0)
        momScP = (m1p ? 1 : 0) + (m2p ? 1 : 0) + (m3p ? 1 : 0) + (m4 ? 1 : 0) + (m5p ? 1 : 0)
        nearPivot = T.on and (T.active or (baseI >= 0 and xL - xOf(S, baseI) <= 0.35 * lenT))
        fMom := nearPivot and momSc >= math.min(iMomAl, momMax) and momScP < math.min(iMomAl, momMax)

        // ─── Sincronía: grados con ventana activa ahora
        string syncTxt = ""
        int syncN = 0
        int syncP = 0
        for i = 0 to 3
            Lq = LV.get(i)
            if Lq.on
                wq = winF * Lq.len
                if Lq.active
                    syncN += 1
                    syncTxt := syncTxt + (syncTxt == "" ? "" : " + ") + lvName(i)
                if xP >= Lq.nextPx - wq and xP <= Lq.nextPx + wq
                    syncP += 1
        syncN += hurstAct + (rAct ? 1 : 0)
        syncTxt := syncTxt + (hurstAct > 0 ? (syncTxt == "" ? "" : " + ") + "Hurst" : "") + (rAct ? (syncTxt == "" ? "" : " + ") + "Ratio" : "")
        fSync := syncN >= 2 and syncP + hurstAct + (rAct ? 1 : 0) < 2

        // ─── Eventos del nivel de trading
        if T.on
            fWin := xL >= T.nextPx - wXT and xP < T.nextPx - wXT
            fIdeal := xL >= T.nextPx and xP < T.nextPx
            if np > 0
                lp = T.px.get(np - 1)
                if xP < lp + wXT and xL >= lp + wXT and T.st.get(np - 1) == 0
                    fInv := true
                    fRedr := T.st2 == 0

        // ─── Alertas dinámicas (idioma seleccionable)
        tk = syminfo.ticker + " · "
        if iAWin and fWin
            alert(tk + txt("Entra en la ventana de pivote ", "Entering pivot window ") + lvName(tI) + " (" + fmtT(timeOf(S, T.nextPx - wXT)) + " → " + fmtT(timeOf(S, T.nextPx + wXT)) + ")", alert.freq_once_per_bar_close)
        if iAIdeal and fIdeal
            alert(tk + txt("Fecha ideal del pivote ", "Ideal pivot date ") + lvName(tI), alert.freq_once_per_bar_close)
        if iAInv and fInv
            alert(tk + txt("Pivote inválido en ", "Invalid pivot on ") + lvName(tI) + (fRedr ? txt(" · 2 seguidos: REDIBUJAR ciclos", " · 2 in a row: REDRAW cycles") : ""), alert.freq_once_per_bar_close)
        if iASig and fLong
            alert(tk + txt("LARGO: ruptura de línea bajista en ventana ", "LONG: downtrend break in window ") + lvName(tI), alert.freq_once_per_bar_close)
        if iASig and fShort
            alert(tk + txt("CORTO: cruce bajo VTL ", "SHORT: cross below VTL ") + lvName(tI), alert.freq_once_per_bar_close)
        if iAMom and fMom
            alert(tk + txt("Momentum alcista en pivote: ", "Bullish momentum at pivot: ") + str.tostring(momSc) + "/" + str.tostring(momMax), alert.freq_once_per_bar_close)
        if iASync and fSync
            alert(tk + txt("Sincronía de ciclos: ", "Cycle synchrony: ") + syncTxt, alert.freq_once_per_bar_close)
        if iATp and fTp
            alert(tk + txt("Objetivo estadístico alcanzado (", "Statistical target hit (") + lvName(tI) + ")", alert.freq_once_per_bar_close)
        if iARatio and fRatio
            alert(tk + txt("El ratio entra en ventana de pivote", "Ratio entering pivot window"), alert.freq_once_per_bar_close)

        // ─── Tabla
        if iTable
            rowMsg(tb, 0, txt("CICLOS DE TIEMPO · ", "TIME CYCLES · ") + syminfo.ticker + " · " + (S.cal ? txt("calendario", "calendar") : txt("barras", "bars")), fg, hBg)
            rowMsg(tb, 1, txt("Anclas ", "Anchors ") + (iAnchor == "Manual" ? "(manual)" : "(auto)") + ": " + fmtT(timeOf(S, exA)) + " → " + fmtT(timeOf(S, exB)) + " · " + txt("subdivisión ", "subdivision ") + str.tostring(LV.get(1).ratio) + "·" + str.tostring(LV.get(2).ratio) + "·" + str.tostring(LV.get(3).ratio), fg, tBg)
            hdr = array.from(txt("Nivel", "Level"), txt("Longitud", "Length"), "Hurst", "÷", txt("Aciertos", "Hits"), txt("Próximo pivote", "Next pivot"), txt("Estado", "Status"))
            for c = 0 to 6
                tCell(tb, c, 2, hdr.get(c), fg, hBg)
            for i = 0 to 3
                Lq = LV.get(i)
                r = 3 + i
                dd = lenDays(S, Lq.len)
                lvTxt = (i == tI ? "★ " : "") + lvName(i) + (i == dom ? " ◆" : "")
                tCell(tb, 0, r, lvTxt, cols.get(i), tBg)
                tCell(tb, 1, r, fmtDays(dd) + " · " + str.tostring(lenBars(S, Lq.len), "#") + "b", fg, tBg)
                tCell(tb, 2, r, hurstName(dd), fg, tBg)
                tCell(tb, 3, r, i == 0 ? "—" : str.tostring(Lq.ratio), fg, tBg)
                if not Lq.on
                    tCell(tb, 4, r, txt("muy corto", "too short"), color.new(fg, 50), tBg)
                    tCell(tb, 5, r, "—", color.new(fg, 50), tBg)
                    tCell(tb, 6, r, "—", color.new(fg, 50), tBg)
                else
                    hr = Lq.tested > 0 ? Lq.valid * 100.0 / Lq.tested : na
                    hc = na(hr) ? fg : hr >= iTarget ? cOk : hr >= 60 ? cWarn : cBad
                    tCell(tb, 4, r, str.tostring(Lq.valid) + "/" + str.tostring(Lq.tested) + (na(hr) ? "" : " · " + str.tostring(hr, "#") + "%"), hc, tBg)
                    wq = winF * Lq.len
                    tCell(tb, 5, r, fmtT(timeOf(S, Lq.nextPx)) + " ±" + fmtDays(lenDays(S, wq)), fg, tBg)
                    redraw = Lq.st1 == 0 and Lq.st2 == 0
                    dl = lenDays(S, Lq.nextPx - wq - xL)
                    stx = redraw ? txt("⚠ redibujar", "⚠ redraw") : Lq.active ? txt("EN VENTANA", "IN WINDOW") : txt("faltan ", "in ") + fmtDays(math.max(dl, 0))
                    tCell(tb, 6, r, stx, redraw ? cBad : Lq.active ? #E6B422 : fg, tBg)
            hrT = T.tested > 0 ? T.valid * 100.0 / T.tested : 0.0
            stT = T.st1 == 0 and T.st2 == 0 ? txt("REDIBUJAR (2 fallos seguidos)", "REDRAW (2 misses in a row)") : hrT >= iTarget ? txt("válido (≥ objetivo)", "valid (≥ target)") : hrT >= 60 ? txt("aceptable", "acceptable") : txt("débil: considere otro activo/TF", "weak: consider another asset/TF")
            rowMsg(tb, 7, "★ " + txt("Trading: ", "Trading: ") + lvName(tI) + " · ◆ " + txt("dominante: ", "dominant: ") + lvName(dom) + " · " + stT, T.st1 == 0 and T.st2 == 0 ? cBad : hrT >= iTarget ? cOk : cWarn, tBg)
            rowMsg(tb, 8, txt("Sincronía ahora: ", "Synchrony now: ") + (syncN > 0 ? str.tostring(syncN) + " (" + syncTxt + ")" : txt("ninguna ventana activa", "no active window")), syncN >= 2 ? #E6B422 : fg, tBg)
            rowMsg(tb, 9, "Hurst: " + (iHurst ? (hurstTxt == "" ? txt("sin mínimo extremo reciente (≤20W)", "no recent extreme low (≤20W)") : hurstTxt) : txt("desactivado", "off")), iColH, tBg)
            rowMsg(tb, 10, "Momentum " + str.tostring(momSc) + "/" + str.tostring(momMax) + " · " + txt("Base ", "Base ") + ck(m1) + " " + txt("Estructura ", "Structure ") + ck(m2) + " EMA " + ck(emaOk) + " ATR " + ck(atrOk) + " Ratio " + (rOn ? ck(m4) : "n/d") + " Vol " + (hasVol ? ck(m5) : "n/d"), momSc >= iMomAl ? cOk : fg, tBg)
            rowMsg(tb, 11, "Ratio: " + (rOn ? rSymReq + " · " : "") + rTxt, rOk ? fg : color.new(fg, 40), tBg)
            float trNow = na
            if baseI >= 0
                trNow := (xOf(S, qMax(S, baseI, n - 1)) - xOf(S, baseI)) / lenT
            trTxt = na(trNow) ? "—" : trNow < 0.45 ? txt("techo temprano (izquierda)", "early top (left)") : trNow > 0.55 ? txt("techo tardío (derecha)", "late top (right)") : txt("simétrico", "symmetric")
            rowMsg(tb, 12, txt("Traslación ciclo actual: ", "Current cycle translation: ") + trTxt + (na(leftPct) ? "" : txt(" · histórico izquierda ", " · historical left ") + str.tostring(leftPct * 100, "#") + "%"), fg, tBg)
            if statsOk
                rowMsg(tb, 13, txt("Estadística ", "Statistics ") + lvName(tI) + " (" + str.tostring(nS) + txt(" pivotes): TP1 ", " pivots): TP1 ") + fmtPct(tp1P) + " (" + str.tostring(nS) + "/" + str.tostring(nS) + ") · TP2 " + fmtPct(tp2P) + " (" + str.tostring(nTp2) + "/" + str.tostring(nS) + ") · TP3 " + fmtPct(tp3P) + " (50%)", fg, tBg)
                rowMsg(tb, 14, txt("Techo típico: día ", "Typical top: day ") + fmtDays(lenDays(S, tpq1 * lenT)) + "–" + fmtDays(lenDays(S, tpq3 * lenT)) + txt(" (mediana ", " (median ") + fmtDays(lenDays(S, tpMed * lenT)) + ")" + (na(retMed) ? "" : txt(" · retroceso típico ", " · typical retrace ") + str.tostring(retMed, "#.###")), fg, tBg)
            else
                rowMsg(tb, 13, txt("Estadística: pocos pivotes válidos (", "Statistics: too few valid pivots (") + str.tostring(nS) + "/" + str.tostring(iStatMin) + ")", color.new(fg, 40), tBg)
                rowMsg(tb, 14, "—", color.new(fg, 40), tBg)
            rowMsg(tb, 15, txt("Ciclo actual: ", "Current cycle: ") + (baseI >= 0 ? txt("mínimo ", "low ") + fmtT(S.t.get(baseI)) + " · " + txt("expansión ", "expansion ") + fmtPct(curExp) + " · " + strength : txt("sin base válida aún", "no valid base yet")), fg, tBg)
            string sigTxt = "—"
            if lastSig >= 0
                jS = sgBar.get(lastSig)
                sigTxt := (sgDir.get(lastSig) > 0 ? txt("LARGO ", "LONG ") : txt("CORTO ", "SHORT ")) + fmtT(S.t.get(jS)) + " · " + txt("entrada ", "entry ") + str.tostring(sgE.get(lastSig), format.mintick) + " · SL " + str.tostring(sgS.get(lastSig), format.mintick)
            rowMsg(tb, 16, txt("Última señal: ", "Last signal: ") + sigTxt, lastSig >= 0 ? (sgDir.get(lastSig) > 0 ? iColUp : iColDn) : fg, tBg)
            string warn = ""
            if lenDays(S, lenT) < 5
                warn := warn + txt("Ciclo de trading < 5D: la guía lo considera poco fiable (ideal 20D+). ", "Trading cycle < 5D: the guide considers it unreliable (ideal 20D+). ")
            if T.tested < 3
                warn := warn + txt("Pocas pruebas en el nivel de trading. ", "Few tests on the trading level. ")
            if redrawTxt != ""
                warn := warn + txt("Redibujar: ", "Redraw: ") + redrawTxt + ". "
            rowMsg(tb, 17, warn == "" ? txt("Ciclos dan el CUÁNDO, el precio da el DÓNDE. Confirmar con estructura, ratio y momentum.", "Cycles give WHEN, price gives WHERE. Confirm with structure, ratio and momentum.") : "⚠ " + warn, warn == "" ? color.new(fg, 35) : cWarn, tBg)

// ════════════════════════════════════════════════════════════════════════════
//  Condiciones de alerta estáticas (también disponibles vía "alert() function calls")
// ════════════════════════════════════════════════════════════════════════════
alertcondition(fWin, "Ventana de pivote / Pivot window", "Time Cycles: entra en ventana de pivote / entering pivot window")
alertcondition(fIdeal, "Fecha ideal / Ideal date", "Time Cycles: fecha ideal del pivote / ideal pivot date")
alertcondition(fInv, "Ciclo invalidado / Cycle invalidated", "Time Cycles: pivote inválido / invalid pivot")
alertcondition(fRedr, "Redibujar ciclos / Redraw cycles", "Time Cycles: 2 pivotes inválidos seguidos / 2 invalid pivots in a row")
alertcondition(fLong, "Señal largo VTL / VTL long", "Time Cycles: largo / long")
alertcondition(fShort, "Señal corto VTL / VTL short", "Time Cycles: corto / short")
alertcondition(fMom, "Momentum en pivote / Momentum at pivot", "Time Cycles: momentum alcista en pivote / bullish momentum at pivot")
alertcondition(fSync, "Sincronía / Synchrony", "Time Cycles: sincronía de ciclos / cycle synchrony")
alertcondition(fTp, "Objetivo estadístico / Statistical target", "Time Cycles: objetivo estadístico alcanzado / statistical target hit")
alertcondition(fRatio, "Ratio en ventana / Ratio in window", "Time Cycles: ratio en ventana de pivote / ratio in pivot window")
